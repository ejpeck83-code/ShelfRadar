# Application
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
APP_TIME_ZONE=America/Indiana/Indianapolis
LIVE_INGESTION_ENABLED=false
FIXTURE_INGESTION_ENABLED=true
SHELF_RADAR_DATA_MODE=fixture
CRON_SECRET=replace-with-a-long-random-value

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/shelf_radar
DATABASE_DIRECT_URL=
# Tests only; point at a disposable PostgreSQL database
TEST_DATABASE_URL=

# Single-user access
AUTH_MODE=development
AUTH_SECRET=replace-with-a-long-random-value
ALLOWED_USER_EMAIL=

# Discovery configuration
TMNT_DISCOVERY_TERMS=TMNT,Teenage Mutant Ninja Turtles,NECA TMNT,Last Ronin,Mutant Mayhem,TMNT GI Joe
LOCAL_LOCATION_TERMS=Indianapolis,Indy,Indiana,Fishers,Carmel,Westfield,Castleton,Noblesville
REGIONAL_LOCATION_TERMS=Cincinnati,Louisville
ACTIVE_ONLINE_RETAILERS=neca

# Retail provider modes: fixture | unavailable | provider
TARGET_ADAPTER_MODE=fixture
TARGET_PROVIDER_BASE_URL=
TARGET_PROVIDER_API_KEY=
WALMART_ADAPTER_MODE=fixture
WALMART_PROVIDER_BASE_URL=
WALMART_PROVIDER_API_KEY=
MEIJER_ADAPTER_MODE=fixture
MEIJER_PROVIDER_BASE_URL=
MEIJER_PROVIDER_API_KEY=
NECA_ADAPTER_MODE=fixture
NECA_PROVIDER_BASE_URL=
NECA_PROVIDER_API_KEY=
ONLINE_RETAIL_ADAPTER_MODE=fixture

# Reddit / crowd sources
REDDIT_ADAPTER_MODE=fixture
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=
REDDIT_USER_AGENT=shelf-radar/0.1 by configured-owner
REDDIT_COMMUNITIES=TMNT,NECATMNT,ActionFigures,RossFinds

# Scheduler and limits
DISCOVERY_CRON=0 6,18 * * *
CROWD_CRON=15 * * * *
AVAILABILITY_CRON=45 */2 * * *
ADAPTER_REQUEST_TIMEOUT_MS=15000
ADAPTER_MAX_PAGES_PER_RUN=5
ADAPTER_MIN_REQUEST_INTERVAL_MS=1000
RAW_SOURCE_RETENTION_DAYS=30

# Optional observability
SENTRY_DSN=
LOG_LEVEL=info
