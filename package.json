{
  "name": "shelf-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "postcss": "8.5.10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'tests/integration/**' --exclude 'tests/crowd/postgres.integration.test.ts' --exclude 'tests/e2e/**'",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration tests/crowd/postgres.integration.test.ts --maxWorkers=1",
    "test:all": "npm test && npm run test:integration",
    "test:e2e": "playwright test",
    "test:preview": "playwright test tests/e2e/preview-smoke.spec.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:seed": "node --import tsx scripts/seed.ts",
    "demo:fixtures": "node --import tsx scripts/fixture-demo.ts",
    "demo:retail-fixtures": "node --import tsx scripts/retail-fixture-demo.ts",
    "demo:web": "cross-env SHELF_RADAR_DATA_MODE=fixture next dev"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.10",
    "postgres": "3.4.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@types/node": "25.0.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "cross-env": "10.1.0",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.10",
    "fast-glob": "3.3.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
